/**
 * The document's whole client. Frame protocol 2.
 *
 * It sends exactly two messages — `ready` once, and `invoke` when the button is
 * pressed, naming the action by its identity (`<spec slug>#<key>`) — and
 * ignores every host message it does not recognise, which is what lets a newer
 * host talk to it.
 *
 * It asks for nothing: no `request`, no `save-state`, no storage. What it draws
 * is what its component sent as `props`. The `invoke` goes to the component
 * (`components/{{panelId}}.ts`), which passes it on to the widget's actions.
 *
 * ✎ CHANGE: `draw()` — what this document reads off its props — and the
 *   action identity the button fires.
 */

/** ✎ CHANGE: the identity of a contributed action (`--action` scaffolds one). */
const ACTION_KEY = '{{askSpecId}}#{{askActionKey}}'

let port = null
const count = document.getElementById('count')

/** ✎ CHANGE: everything this document knows, it reads here — its component's props. */
function draw(props) {
	const lines = (props && props.messages) || 0
	count.textContent = lines === 1 ? '1 message' : `${lines} messages`
}

document.getElementById('act').addEventListener('click', () => {
	if (port) port.postMessage({ t: 'invoke', key: ACTION_KEY, payload: {} })
})

addEventListener('message', (e) => {
	if (e.data?.t !== 'init' || !e.ports[0]) return
	port = e.ports[0]
	port.onmessage = (m) => {
		if (m.data?.t === 'props') draw(m.data.props)
	}
	port.postMessage({ t: 'ready' })
})
