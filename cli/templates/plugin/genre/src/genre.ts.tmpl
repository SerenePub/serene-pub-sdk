/**
 * The genre — what kind of session this is, and it owns its id.
 *
 * A genre is a **package-level declaration**, like a pipeline: the shape sits
 * here, every surface reads it, and it is not a habit of whichever pipelines
 * happen to be bound. Say the rules once, in the one place an instance,
 * the session picker and the layout all read.
 *
 * ✎ CHANGE: the shape, the events, and the description. Everything below is a
 *   working default — the standard chat's shape, narrowed to nothing in
 *   particular.
 */

import { genre, sessionEvents, type GenreDecl } from '@serene-pub/sdk'

export const GENRE_ID = '{{genreId}}'

export const {{genreVar}}: GenreDecl = genre(GENRE_ID, {
	name: { en: '{{displayName}}' },
	/**
	 * An open string; the session picker groups its cards by it. `chat`,
	 * `adventure` and `game` are the families in use.
	 */
	family: 'chat',
	description: { en: '✎ CHANGE: one sentence, on the card in the session picker.' },
	/**
	 * The shape: what a session of this genre may hold, and what it may do.
	 * Stated here rather than assumed, so every surface agrees.
	 */
	shape: {
		characters: { min: 1 },
		personas: { min: 0, max: 1 },
		lorebook: 'optional',
		composer: 'text',
		voice: 'character',
		greeting: { enabled: true, channel: 'main' },
	},
	/**
	 * The event surface: which session events exist here, and which a preset
	 * must bind. `session-created` is required for every genre whether it is
	 * written or not — a genre nothing can instantiate is not a genre.
	 *
	 * `open` means no preset binds it: the slot is filled by the contributed
	 * actions a preset includes.
	 */
	events: {
		[sessionEvents.messageRespond]: { required: true },
		[sessionEvents.sessionAction]: { open: true },
	},
})
