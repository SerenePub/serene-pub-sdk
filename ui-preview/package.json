{
	"name": "@serene-pub/ui-preview",
	"version": "0.6.0-pr-4",
	"description": "The Serene Pub surface harness: a SvelteKit dev server that renders the UI surfaces a package announces — frame panels in a real opaque-origin sandbox, components in the host document — with hot reload. Launched by `serene-pub ui`.",
	"license": "Apache-2.0",
	"homepage": "https://github.com/SerenePub/serene-pub-sdk/tree/main/ui-preview#readme",
	"bugs": {
		"url": "https://github.com/SerenePub/serene-pub-sdk/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/SerenePub/serene-pub-sdk.git",
		"directory": "ui-preview"
	},
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"private": false,
	"files": [
		"src",
		"static",
		"vite",
		"server.js",
		"server.d.ts",
		"svelte.config.js",
		"vite.config.ts",
		"README.md",
		"NOTICE"
	],
	"exports": {
		"./server": {
			"types": "./server.d.ts",
			"import": "./server.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "echo 'dev-only harness — nothing to build'",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
	},
	"dependencies": {
		"@serene-pub/controls": "^0.6.0-pr-4",
		"@skeletonlabs/skeleton": "^5.0.0",
		"@sveltejs/kit": "^2.22.0",
		"@sveltejs/vite-plugin-svelte": "^5.1.0",
		"@tailwindcss/forms": "^0.5.10",
		"@tailwindcss/vite": "^4.0.0",
		"svelte": "^5.56.0",
		"tailwindcss": "^4.0.0",
		"vite": "^6.4.0"
	},
	"peerDependencies": {
		"@serene-pub/sdk": "^0.6.0-pr-4"
	},
	"devDependencies": {
		"@serene-pub/sdk": "0.6.0-pr-4",
		"svelte-check": "^4.0.0",
		"typescript": "~5.9.0"
	},
	"publishConfig": {
		"access": "public",
		"tag": "next"
	}
}
