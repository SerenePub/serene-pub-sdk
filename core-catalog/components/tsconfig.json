{
	// Type-checks core's component sources (`components/**`) on their own, as
	// they are written: against the SDK's contract types and the SDK's Svelte,
	// with no host's ambient types. Nothing here is emitted — the CLI's
	// component bundler builds them — so no option may shape what esbuild
	// writes (no `paths`/`baseUrl`: esbuild resolves through them too).
	//
	// Check: svelte-check --workspace core-catalog/components \
	//          --tsconfig core-catalog/components/tsconfig.json
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		// A UI worker's world: the DOM Svelte renders into, no Node globals.
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"types": [],
		"strict": true,
		"module": "ESNext",
		"moduleResolution": "bundler",
		"isolatedModules": true,
		"skipLibCheck": true,
		"noEmit": true
	},
	"include": ["**/*.ts", "**/*.svelte"]
}
