{
	"name": "@serene-pub/core-catalog",
	"version": "0.6.0-pr-5",
	"description": "The genres, pipelines, hook declarations and core components Serene Pub ships. Serene Pub seeds from it at boot, conformance uses it as fixtures, and plugin authors import it for typed references.",
	"license": "Apache-2.0",
	"homepage": "https://github.com/SerenePub/serene-pub-sdk/tree/main/core-catalog#readme",
	"bugs": {
		"url": "https://github.com/SerenePub/serene-pub-sdk/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/SerenePub/serene-pub-sdk.git",
		"directory": "core-catalog"
	},
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"sideEffects": [
		"./dist/index.js",
		"./dist/registry/entries.js",
		"./dist/registry/statShapes.js",
		"./dist/registry/slots.js",
		"./dist/rulesets/vis-itineris/slots.js",
		"./dist/rulesets/wherewithal/slots.js",
		"./dist/functions/values.js",
		"./dist/functions/deciding.js",
		"./dist/functions/changing.js",
		"./dist/functions/scopes.js",
		"./dist/functions/pieces.js",
		"./dist/functions/time.js",
		"./dist/functions/progression.js",
		"./dist/functions/asking.js",
		"./dist/functions/atZeroHealth.js",
		"./dist/functions/outcomeMoves.js",
		"./dist/rulesets/archetypes/romance.js",
		"./dist/rulesets/archetypes/sliceOfLife.js",
		"./dist/rulesets/archetypes/workplace.js",
		"./dist/rulesets/archetypes/cardGame.js",
		"./dist/rulesets/templates/slots.js",
		"./dist/rulesets/templates/d20Style.js",
		"./dist/rulesets/templates/dicePool.js",
		"./dist/rulesets/templates/dicelessPools.js",
		"./dist/registry/rulesets.js",
		"./dist/registry/primers.js",
		"./dist/registry/genres.js",
		"./dist/registry/hostState.js",
		"./dist/shared/annexField.js",
		"./dist/registry/widgets.js"
	],
	"files": [
		"dist",
		"!dist/**/*.map",
		"components",
		"README.md",
		"NOTICE"
	],
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./conversation": {
			"types": "./dist/shared/ui/conversation/index.d.ts",
			"import": "./dist/shared/ui/conversation/index.js"
		},
		"./session-state": {
			"types": "./dist/shared/ui/session-state/index.d.ts",
			"import": "./dist/shared/ui/session-state/index.js"
		},
		"./widgets": {
			"types": "./dist/shared/ui/widgetContext.d.ts",
			"import": "./dist/shared/ui/widgetContext.js"
		},
		"./core-widgets": {
			"types": "./dist/shared/ui/coreWidgetsEntry.d.ts",
			"import": "./dist/shared/ui/coreWidgetsEntry.js"
		},
		"./lore-entries": {
			"types": "./dist/shared/ui/lore-entries/index.d.ts",
			"import": "./dist/shared/ui/lore-entries/index.js"
		},
		"./authors-note": {
			"types": "./dist/genres/story/ui/authors-note/index.d.ts",
			"import": "./dist/genres/story/ui/authors-note/index.js"
		},
		"./scene-portraits": {
			"types": "./dist/shared/ui/scene-portraits/index.d.ts",
			"import": "./dist/shared/ui/scene-portraits/index.js"
		},
		"./turn-order": {
			"types": "./dist/shared/ui/turn-order/index.d.ts",
			"import": "./dist/shared/ui/turn-order/index.js"
		},
		"./actions": {
			"types": "./dist/shared/ui/actions/index.d.ts",
			"import": "./dist/shared/ui/actions/index.js"
		},
		"./annex": {
			"types": "./dist/shared/ui/annex/index.d.ts",
			"import": "./dist/shared/ui/annex/index.js"
		},
		"./album": {
			"types": "./dist/shared/ui/album/index.d.ts",
			"import": "./dist/shared/ui/album/index.js"
		},
		"./backdrop": {
			"types": "./dist/shared/ui/backdrop/index.d.ts",
			"import": "./dist/shared/ui/backdrop/index.js"
		},
		"./chronicle": {
			"types": "./dist/shared/ui/chronicle/index.d.ts",
			"import": "./dist/shared/ui/chronicle/index.js"
		},
		"./places": {
			"types": "./dist/shared/ui/places/index.d.ts",
			"import": "./dist/shared/ui/places/index.js"
		},
		"./attendance": {
			"types": "./dist/shared/ui/attendance/index.d.ts",
			"import": "./dist/shared/ui/attendance/index.js"
		},
		"./loadouts": {
			"types": "./dist/loadouts.d.ts",
			"import": "./dist/loadouts.js"
		},
		"./components/*": "./dist/components/*",
		"./package.json": "./package.json"
	},
	"peerDependencies": {
		"@serene-pub/component-client": "^0.6.0-pr-5",
		"@serene-pub/contracts": "^0.6.0-pr-5",
		"@serene-pub/sdk": "^0.6.0-pr-5",
		"svelte": ">=5"
	},
	"peerDependenciesMeta": {
		"@serene-pub/component-client": {
			"optional": true
		},
		"svelte": {
			"optional": true
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json && node scripts/copyNotices.mjs && node scripts/buildComponents.mjs",
		"check": "svelte-check --workspace components --tsconfig ./tsconfig.json --threshold error"
	},
	"devDependencies": {
		"@serene-pub/cli": "0.6.0-pr-5",
		"@serene-pub/component-client": "0.6.0-pr-5",
		"@serene-pub/contracts": "0.6.0-pr-5",
		"@serene-pub/sdk": "0.6.0-pr-5",
		"svelte": "^5.56.0",
		"svelte-check": "^4.7.6",
		"typescript": "~5.9.0"
	},
	"publishConfig": {
		"access": "public",
		"tag": "next"
	}
}
