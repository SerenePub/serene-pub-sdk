{
	"name": "@serene-pub/core-catalog",
	"version": "0.6.0-pr-2",
	"description": "The genres, pipelines, hook declarations and core components Serene Pub ships. Serene Pub seeds from it at boot, conformance uses it as fixtures, and plugin authors import it for typed references.",
	"license": "Apache-2.0",
	"homepage": "https://github.com/SerenePub/serene-pub-sdk/tree/main/core-catalog#readme",
	"bugs": {
		"url": "https://github.com/SerenePub/serene-pub-sdk/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/SerenePub/serene-pub-sdk.git",
		"directory": "core-catalog"
	},
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"sideEffects": [
		"./dist/index.js",
		"./dist/entries.js",
		"./dist/statShapes.js",
		"./dist/slots.js",
		"./dist/genres.js",
		"./dist/annexField.js",
		"./dist/ui/sessions/widgets.js"
	],
	"files": [
		"dist",
		"!dist/**/*.map",
		"components",
		"README.md",
		"NOTICE"
	],
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./conversation": {
			"types": "./dist/ui/sessions/conversation/index.d.ts",
			"import": "./dist/ui/sessions/conversation/index.js"
		},
		"./session-state": {
			"types": "./dist/ui/sessions/session-state/index.d.ts",
			"import": "./dist/ui/sessions/session-state/index.js"
		},
		"./widgets": {
			"types": "./dist/ui/sessions/widgetContext.d.ts",
			"import": "./dist/ui/sessions/widgetContext.js"
		},
		"./core-widgets": {
			"types": "./dist/ui/sessions/coreWidgetsEntry.d.ts",
			"import": "./dist/ui/sessions/coreWidgetsEntry.js"
		},
		"./lore-entries": {
			"types": "./dist/ui/sessions/lore-entries/index.d.ts",
			"import": "./dist/ui/sessions/lore-entries/index.js"
		},
		"./authors-note": {
			"types": "./dist/ui/sessions/authors-note/index.d.ts",
			"import": "./dist/ui/sessions/authors-note/index.js"
		},
		"./scene-portraits": {
			"types": "./dist/ui/sessions/scene-portraits/index.d.ts",
			"import": "./dist/ui/sessions/scene-portraits/index.js"
		},
		"./components/*": "./dist/components/*",
		"./package.json": "./package.json"
	},
	"peerDependencies": {
		"@serene-pub/sdk": "^0.6.0-pr-2",
		"@serene-pub/contracts": "^0.6.0-pr-2",
		"@serene-pub/component-client": "^0.6.0-pr-2",
		"svelte": ">=5"
	},
	"peerDependenciesMeta": {
		"@serene-pub/component-client": {
			"optional": true
		},
		"svelte": {
			"optional": true
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json && node scripts/buildComponents.mjs"
	},
	"devDependencies": {
		"@serene-pub/sdk": "0.6.0-pr-2",
		"@serene-pub/contracts": "0.6.0-pr-2",
		"@serene-pub/cli": "0.6.0-pr-2",
		"@serene-pub/component-client": "0.6.0-pr-2",
		"svelte": "^5.56.0"
	},
	"publishConfig": {
		"access": "public",
		"tag": "next"
	}
}
