{
	"name": "@serene-pub/docs",
	"version": "0.6.0-pr-2",
	"description": "Serene Pub's docs compiler: markdown sources plus rendered announcement pages in, a manifest, a search index and one HTML file per page out.",
	"license": "Apache-2.0",
	"homepage": "https://github.com/SerenePub/serene-pub-sdk/tree/main/docs#readme",
	"bugs": {
		"url": "https://github.com/SerenePub/serene-pub-sdk/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/SerenePub/serene-pub-sdk.git",
		"directory": "docs"
	},
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"files": [
		"dist",
		"!dist/**/*.map",
		"README.md",
		"NOTICE"
	],
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./graph": {
			"types": "./dist/graph.d.ts",
			"import": "./dist/graph.js"
		},
		"./spec-graph": {
			"types": "./dist/specGraph.d.ts",
			"import": "./dist/specGraph.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json"
	},
	"dependencies": {
		"@jsquash/webp": "^1.5.0",
		"elkjs": "^0.12.0",
		"github-slugger": "^2.0.0",
		"jimp": "^1.6.1",
		"marked": "^15.0.12",
		"shiki": "^4.4.3"
	},
	"peerDependencies": {
		"@serene-pub/sdk": "^0.6.0-pr-2"
	},
	"peerDependenciesMeta": {
		"@serene-pub/sdk": {
			"optional": true
		}
	},
	"devDependencies": {
		"@serene-pub/sdk": "0.6.0-pr-2"
	},
	"publishConfig": {
		"access": "public",
		"tag": "next"
	}
}
