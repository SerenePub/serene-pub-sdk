{
	"name": "@serene-pub/controls",
	"version": "0.6.0-pr-2",
	"description": "Svelte controls for Serene Pub value types: one editor per value-type id plus a schema form renderer. Shipped as source; the consuming app's Svelte compiles it.",
	"license": "Apache-2.0",
	"homepage": "https://github.com/SerenePub/serene-pub-sdk/tree/main/controls#readme",
	"bugs": {
		"url": "https://github.com/SerenePub/serene-pub-sdk/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/SerenePub/serene-pub-sdk.git",
		"directory": "controls"
	},
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"svelte": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"svelte": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./registry": {
			"types": "./src/registry.ts",
			"import": "./src/registry.ts"
		},
		"./package.json": "./package.json"
	},
	"peerDependencies": {
		"svelte": ">=5",
		"@serene-pub/sdk": "^0.6.0-pr-2"
	},
	"scripts": {
		"build": "echo 'raw-source svelte library — nothing to build'"
	},
	"peerDependenciesMeta": {
		"svelte": {
			"optional": true
		}
	},
	"files": [
		"src",
		"README.md",
		"NOTICE"
	],
	"publishConfig": {
		"access": "public",
		"tag": "next"
	}
}
