{
	"name": "@serene-pub/sdk",
	"version": "0.6.0-pr-4",
	"description": "Author Serene Pub pipelines and plugins: nodes, specs, the executor, and the author-side test harness.",
	"license": "Apache-2.0",
	"homepage": "https://github.com/SerenePub/serene-pub-sdk/tree/main/sdk#readme",
	"bugs": {
		"url": "https://github.com/SerenePub/serene-pub-sdk/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/SerenePub/serene-pub-sdk.git",
		"directory": "sdk"
	},
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"sideEffects": false,
	"files": [
		"dist",
		"!dist/**/*.map",
		"host-elements.d.ts",
		"README.md",
		"NOTICE"
	],
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./testing": {
			"types": "./dist/testing.d.ts",
			"import": "./dist/testing.js"
		},
		"./tokenizers": {
			"types": "./dist/tokenizers.d.ts",
			"import": "./dist/tokenizers.js"
		},
		"./component": {
			"types": "./dist/component.d.ts",
			"import": "./dist/component.js"
		},
		"./template-check": {
			"types": "./dist/templateCheck.d.ts",
			"import": "./dist/templateCheck.js"
		},
		"./host-elements": {
			"types": "./host-elements.d.ts"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"host-elements": "node scripts/writeHostElementsDts.mjs"
	},
	"dependencies": {
		"handlebars": "^4.7.8",
		"liquidjs": "10.29.0"
	},
	"publishConfig": {
		"access": "public",
		"tag": "next"
	}
}
