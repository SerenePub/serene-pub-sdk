{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@serene-pub/sdk": [
        "../sdk/src/index.ts"
      ],
      "@serene-pub/sdk/testing": [
        "../sdk/src/testing.ts"
      ],
      "@serene-pub/sdk/tokenizers": [
        "../sdk/src/tokenizers.ts"
      ],
      "@serene-pub/contracts": [
        "../contracts/src/index.ts"
      ],
      "@serene-pub/conformance": [
        "../conformance/src/index.ts"
      ],
      "@serene-pub/cli": [
        "../cli/src/index.ts"
      ],
      "@serene-pub/cli/bin": [
        "../cli/src/bin.ts"
      ],
      "@serene-pub/docs": [
        "../docs/src/index.ts"
      ]
    }
  },
  "include": [
    "*.ts",
    "examples/*.ts",
    "../*/src/**/*.ts"
  ],
  "exclude": [
    "../ui-preview/**",
    "../playground/**"
  ]
}
